# Copia este archivo a ".env" y completa con los valores de tu proyecto Supabase
# (Project Settings > API en el dashboard). El prefijo EXPO_PUBLIC_ es obligatorio
# para que Expo los incluya en el bundle del cliente — NUNCA pongas aquí la
# service_role key, esa jamás debe viajar al cliente.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
